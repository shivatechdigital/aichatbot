API_BASE_URL=http://localhost:3010/v1/chat/completions
API_KEY=
MODEL_NAME=auto
# Docker API endpoint. Use the API container service name when both containers
# are on the same Compose network, for example:
# LLM_URL=http://my-api-container:3010/v1/chat/completions
# For an API published on the Docker host, use:
# LLM_URL=http://host.docker.internal:3010/v1/chat/completions
LLM_URL=http://host.docker.internal:3010/v1/chat/completions
LLM_MODEL=auto
TEMPERATURE=0.2
MAX_TOKENS=2048
REQUEST_TIMEOUT=120
APP_NAME=Quotation AI Arena
APP_PORT=7860
APP_HOST=0.0.0.0
DEBUG_MODE=False
DATABASE_PATH=data/chat_history.db
LOG_LEVEL=INFO
LOG_FILE=logs/app.log